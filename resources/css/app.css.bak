@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
    [x-cloak] {
        display: none !important;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        @apply bg-slate-50 text-slate-900 antialiased;
    }
}

@layer components {
    .pw-focus {
        @apply outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2;
    }

    .pw-field {
        @apply mt-1 block w-full rounded-lg border-slate-300 bg-white text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-blue-500 focus:ring-blue-500 disabled:cursor-not-allowed disabled:bg-slate-100;
    }

    .pw-label {
        @apply block text-sm font-medium text-slate-700;
    }

    .pw-error {
        @apply mt-1 text-xs font-medium text-red-600;
    }
}
